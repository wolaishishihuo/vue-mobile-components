# npm registry
registry=https://registry.npmjs.org/

# 自动生成package-lock.json
package-lock=true

# 发布时包含.github文件夹
include=.github

# 发布范围设置 (如果使用scoped package)
@jname:registry=https://registry.npmjs.org/
# NPM_TOKEN 在本地通过 npm login 设置，在CI/CD中通过环境变量设置
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}
