{
  "version": 2,
  "name": "vue-mobile-components-playground",
  "buildCommand": "pnpm install && pnpm --filter playground build",
  "outputDirectory": "packages/playground/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, immutable, max-age=31536000"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}