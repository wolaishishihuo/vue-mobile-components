{
  "name": "@jname/vue-mobile-components",
  "version": "1.0.3",
  "description": "基于 Vue 3 + Vant 4 的移动端组件库",
  "author": "Jname",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jname/vue-mobile-components.git"
  },
  "keywords": [
    "vue3",
    "mobile",
    "components",
    "vant",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.es.js",
      "require": "./lib/index.umd.js"
    },
    "./lib/style.css": "./lib/style.css"
  },
  "main": "./lib/index.umd.js",
  "module": "./lib/index.es.js",
  "types": "./lib/index.d.ts",
  "files": [
    "README.md",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky install",
    "prepublishOnly": "pnpm build",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release": "pnpm build && npm publish",
    "release:patch": "pnpm version:patch && pnpm release",
    "release:minor": "pnpm version:minor && pnpm release",
    "release:major": "pnpm version:major && pnpm release",
    "prepublish": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "@vueuse/core": "^10.0.0",
    "vant": "^4.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "5.2.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "eslint": "^9.30.1",
    "eslint-plugin-format": "^1.0.1",
    "husky": "^9.0.11",
    "less": "^4.4.1",
    "lint-staged": "^16.1.5",
    "prettier": "^3.3.2",
    "terser": "^5.43.1",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.0.6"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  }
}
