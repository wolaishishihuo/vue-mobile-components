{
  "name": "@jname/vue-mobile-components-monorepo",
  "version": "1.3.13",
  "description": "基于 Vue 3 + Vant 4 的移动端组件库 - Monorepo",
  "author": "Jname",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jname/vue-mobile-components.git"
  },
  "keywords": [
    "vue3",
    "mobile",
    "components",
    "vant",
    "typescript",
    "monorepo"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm -r --filter=!playground build",
    "build:watch": "pnpm -r --filter=!playground build:watch",
    "preview": "pnpm --filter playground preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare": "husky install",
    "release": "pnpm build && pnpm -r --filter=!playground publish --access public",
    "release:core": "pnpm --filter @jname/core release",
    "release:components": "pnpm --filter @jname/components release",
    "release:business": "pnpm --filter @jname/business release",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "changeset publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "5.2.1",
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-vue": "^5.0.5",
    "eslint": "^9.30.1",
    "eslint-plugin-format": "^1.0.1",
    "husky": "^9.0.11",
    "less": "^4.4.1",
    "lint-staged": "^16.1.5",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.0.6"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  }
}
