{
  "name": "@jname/core",
  "version": "1.0.0",
  "description": "Vue Mobile Components - Core utilities and types",
  "author": "Jname",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js"
    }
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "release": "pnpm build && npm publish --access public"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
