{
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"],
    "experimentalDecorators": true,
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "paths": {
      "@jname/core": ["packages/core/index.ts"],
      "@jname/components": ["packages/components/index.ts"],
      "@jname/business": ["packages/business/index.ts"],
      "@jname/themes": ["packages/themes/index.ts"]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "importHelpers": true,
    "noEmit": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.vue",
    "packages/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/lib",
    "**/demo/**"
  ]
}
